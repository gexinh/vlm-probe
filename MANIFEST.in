# Keep source distributions as small and portable as the installed library.
include README.md pyproject.toml MANIFEST.in LICENSE NOTICE.md CITATION.cff
recursive-include src *.py
recursive-include src/vlm_probing/sae/resources *.json *.json.gz
recursive-include src/vlm_probing/sae/licenses *.txt
include src/vlm_probing/_vendor/chefer2021/LICENSE
include src/vlm_probing/_vendor/chefer2021/README.md
prune build
prune dist
prune docs
prune demos
prune examples
prune tests
prune tools
prune paper
prune papers
prune research
prune report
prune slides
prune outputs
prune results
global-exclude __pycache__ *.py[cod]
